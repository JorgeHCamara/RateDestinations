# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser. Used by the import pipeline and cron.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google OAuth client ID (the same one configured in Supabase's Google provider). Shows Google's own
# sign-in button, whose popup names this site instead of the Supabase project. Not a secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Cloudflare Turnstile site key (Cloudflare dashboard → Turnstile). Adds a bot check to sign-in; the
# secret key goes in Supabase (Authentication → Attack Protection → CAPTCHA), never here. Not a
# secret. For local testing, 1x00000000000000000000AA always passes.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Public contact address shown on /privacy and /terms (for data and deletion requests).
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Import pipeline ---
# Shared secret for POST /api/cities/[id]/import and GET /api/cron/refresh (Vercel Cron sends it as Bearer).
CRON_SECRET=change-me-to-a-long-random-string
# Recommended. Free key from https://www.geoapify.com/ (3,000 credits/day; 1 credit per 20 places).
# When set, places come from Geoapify instead of the public Overpass servers.
GEOAPIFY_API_KEY=
# Places per category per city (default 60, max 500); higher costs more credits.
# GEOAPIFY_PER_CATEGORY=60

# Optional. Comma-separated Overpass endpoints, tried in order (defaults to overpass-api.de + two mirrors).
# OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
# Identify the app to OSM/Wikidata (required by their usage policies).
IMPORT_USER_AGENT=RateDestinations/0.1 (contact: you@example.com)

# --- Optional: Google Places (New). Leave unset to run on free data only. ---
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=

# --- Local development only: direct Postgres URL for scripts/migrations ---
# For a hosted Supabase project use the "Session pooler" or direct connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
